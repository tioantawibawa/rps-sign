# ------------------------------------------------------------------
# RPS Sign — environment variables
# Copy to `.env` for local development. NEVER commit real secrets.
# ------------------------------------------------------------------

# Runtime
NODE_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://rps:rps_password@localhost:5432/rps_sign?schema=public

# Auth.js (NextAuth v5)
# Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-in-production-please-use-a-32-byte-random-string
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Object storage
# STORAGE_DRIVER=local  -> files stored under STORAGE_LOCAL_DIR (no Docker needed)
# STORAGE_DRIVER=s3     -> MinIO / S3-compatible
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=rps-sign
S3_FORCE_PATH_STYLE=true
SIGNED_URL_TTL_SECONDS=300

# Email (Mailpit for local; falls back to console when MAIL_DRIVER=console)
MAIL_DRIVER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM="RPS Sign <no-reply@rps-sign.local>"

# Document processing
LIBREOFFICE_BIN=soffice
CONVERTER_TIMEOUT_MS=120000
DOC_MAX_UPLOAD_BYTES=26214400
SIGNATURE_MAX_UPLOAD_BYTES=2097152

# Rate limiting (in-memory limiter; per-window)
RATE_LIMIT_ENABLED=true

# Observability
LOG_LEVEL=info
